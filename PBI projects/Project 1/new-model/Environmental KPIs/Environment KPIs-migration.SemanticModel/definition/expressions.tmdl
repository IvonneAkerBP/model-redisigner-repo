		    // Edvard Grieg facility, Skarv FPSO, Alvheim FPSO, Ivar Aasen facility)
		    // ==================================================================
		    Mainfield_NOX_Permit = #table(
		        type table [metric=text, field=text, year=Int64.Type, value_permit_kpi=number],
		        {
