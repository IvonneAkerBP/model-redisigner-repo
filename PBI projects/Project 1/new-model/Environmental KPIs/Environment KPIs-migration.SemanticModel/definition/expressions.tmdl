		            {"Flaring Permit", "Alvheim",      2025,  3000000   },
		            {"Flaring Permit", "Ivar Aasen",   2025,  2375000   }
		        }
		    ),
		
		    // ==================================================================
		    // Flaring KPI
		    // Source: Emissions to air partition — [KPI flaring] (annual basis)
		    // Annual KPI = permit × reduction factor at year-end.
		    // Edvard Grieg 2023/2024 used quarterly Division — omitted.
		    // Calculation: Ula=5514000×0.8, Skarv=3240000×1.0, Valhall=3057000×0.9,
		    //              Alvheim=3000000×1.0, Ivar Aasen=2375000×1.0, EG=4711000×1.0
		    // ==================================================================
		    Flaring_KPI = #table(
		        type table [metric=text, field=text, year=Int64.Type, value_permit_kpi=number],
		        {
		            {"Flaring KPI", "Ula",          2025,  4411200   },
