/// Historical air emission reference values — years 2019–2025.
/// Extracted from the SQL CASE and Power Query logic in the legacy fact table
/// partitions (Emissions to air, CH4_NMVOC, Kaldvent volum).
/// Schema: (metric text, field text, year int64, value_permit_kpi number)
/// Covers the years NOT provided by Fabric AIR_REF (which has 2026 only).
/// Enable Load = false — used only as a source by CombinedAirRef.
/// 
/// Known limitations documented in Preparation Completion Report:
/// CO2 KPI Year — 2019–2024 values are the per-row constants from the legacy SQL,
/// not annual tonnage targets. Valhall 2021 months 1–4 used 0.95; stored as 1.4.
/// Flaring Permit/KPI — quarterly granularity for 2019–2024 cannot be represented
/// per (field, year). Only years with a clean annual value are included.
/// Vented gas permit/KPI — same quarterly limitation; only clean annual years included.
/// Ivar Aasen oily water metrics — NULL in legacy SQL due to field-name mapping bug.
expression HistoricalAirRef =
		let
		    // ==================================================================
		    // CO2 KPI Year
		    // Source: Emissions to air partition — column [KPI CO2 tonn]
		    // Note: 2019–2024 store the legacy per-row constant (original units,
		    //   not annual tonnage). 2025 stores the annual tonnage target.
		    //   Valhall 2022/2023 = NULL in SQL (no CASE condition) — omitted.
		    //   Edvard Grieg 2019–2021 = NULL in SQL — omitted.
		    //   Valhall 2021: months 1–4 = 0.95, months 5–12 = 1.4; storing 1.4.
		    // ==================================================================
		    CO2_KPI_Year = #table(
		        type table [metric=text, field=text, year=Int64.Type, value_permit_kpi=number],
		        {
		            {"CO2 KPI Year", "Valhall",      2020,    1.4   },
		            {"CO2 KPI Year", "Valhall",      2021,    1.4   },
		            {"CO2 KPI Year", "Valhall",      2024,    1.8   },
		            {"CO2 KPI Year", "Valhall",      2025, 28000    },
		            {"CO2 KPI Year", "Ula",          2020,   17.5   },
		            {"CO2 KPI Year", "Ula",          2021,   19.15  },
		            {"CO2 KPI Year", "Ula",          2022,   30     },
		            {"CO2 KPI Year", "Ula",          2023,   29.5   },
		            {"CO2 KPI Year", "Ula",          2024,   54.2   },
		            {"CO2 KPI Year", "Ula",          2025, 153900   },
		            {"CO2 KPI Year", "Skarv",        2019,   11.7   },
		            {"CO2 KPI Year", "Skarv",        2020,   11.7   },
		            {"CO2 KPI Year", "Skarv",        2021,    8     },
		            {"CO2 KPI Year", "Skarv",        2022,    8     },
		            {"CO2 KPI Year", "Skarv",        2023,    5.9   },
		            {"CO2 KPI Year", "Skarv",        2024,    6.4   },
		            {"CO2 KPI Year", "Skarv",        2025, 368000   },
		            {"CO2 KPI Year", "Alvheim",      2020,    7     },
		            {"CO2 KPI Year", "Alvheim",      2021,    8.5   },
		            {"CO2 KPI Year", "Alvheim",      2022,    9.5   },
		            {"CO2 KPI Year", "Alvheim",      2023,    9.5   },
		            {"CO2 KPI Year", "Alvheim",      2024,    7.6   },
		            {"CO2 KPI Year", "Alvheim",      2025, 171000   },
		            {"CO2 KPI Year", "Ivar Aasen",   2020,    1     },
		            {"CO2 KPI Year", "Ivar Aasen",   2021,    0.9   },
		            {"CO2 KPI Year", "Ivar Aasen",   2022,    1     },
		            {"CO2 KPI Year", "Ivar Aasen",   2023,    1.8   },
		            {"CO2 KPI Year", "Ivar Aasen",   2024,    1.24  },
		            {"CO2 KPI Year", "Ivar Aasen",   2025, 22000    },
		            {"CO2 KPI Year", "Edvard Grieg", 2022,    5     },
		            {"CO2 KPI Year", "Edvard Grieg", 2023,    1.7   },
		            {"CO2 KPI Year", "Edvard Grieg", 2024,    1.14  },
		            {"CO2 KPI Year", "Edvard Grieg", 2025, 45000    }
		        }
		    ),
		
		    // ==================================================================
		    // Flaring Permit
		    // Source: Emissions to air partition — column [Tillatelse flaring]
		    // The SQL stores QUARTERLY values for 2019–2024. These cannot be
		    // represented per (field, year). Only years with a clean annual
		    // value are included. Edvard Grieg 2023/2024 had annual figures.
		    // 2019–2024 quarterly rows will show known differences in Phase A.
		    // ==================================================================
		    Flaring_Permit = #table(
		        type table [metric=text, field=text, year=Int64.Type, value_permit_kpi=number],
		        {
		            {"Flaring Permit", "Edvard Grieg", 2023,    54000   },
		            {"Flaring Permit", "Edvard Grieg", 2024,  1300000   },
		            {"Flaring Permit", "Edvard Grieg", 2025,  4711000   },
		            {"Flaring Permit", "Ula",          2025,  5514000   },
