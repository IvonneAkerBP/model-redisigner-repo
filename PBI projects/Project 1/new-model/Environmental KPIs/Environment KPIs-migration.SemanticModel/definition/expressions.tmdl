/// Combined air emission reference table — covers all years (2019–2026).
/// Unions HistoricalAirRef (2019–2025) with Fabric AIR_REF (2026), then
/// pivots to wide format: one row per (field, year), one column per metric.
/// This is the lookup surface used by fact table merge steps in Units 1–6.
/// Enable Load = false — used only as a merge source in fact table partitions.
expression CombinedAirRef =
		let
		    // Reference the Fabric AIR_REF table (already in the model)
		    AIR_REF = #"dbt_gold_nems_emission fact_nems__permit_kpi_to_air",
		
		    // Select only the columns needed (drop unit column to match HistoricalAirRef schema)
		    AirRefTall = Table.SelectColumns(AIR_REF, {"metric", "field", "year", "value_permit_kpi"}),
		
		    // Union historical (2019–2025) with Fabric data (2026)
		    Combined = Table.Combine({HistoricalAirRef, AirRefTall}),
		
		    // Sort for stable pivot column ordering
		    Sorted = Table.Sort(Combined, {{"metric", Order.Ascending}, {"field", Order.Ascending}, {"year", Order.Ascending}}),
		
		    // Determine pivot columns from the full combined metric list
		    MetricList = List.Sort(List.Distinct(Sorted[metric])),
		
		    // Pivot by metric — one row per (field, year), one column per metric
		    Pivoted = Table.Pivot(Sorted, MetricList, "metric", "value_permit_kpi", List.First)
		in
		    Pivoted
	lineageTag: c3d4e5f6-a7b8-9012-cdef-123456789012

	annotation PBI_NavigationStepName = Navigasjon

	annotation PBI_ResultType = Table

/// Combined sea discharge reference table — covers all years (2019–2026).
/// Unions HistoricalSeaRef (2019–2025) with Fabric SEA_REF (2026), then
/// pivots to wide format: one row per (field, year), one column per metric.
/// This is the lookup surface used by fact table merge steps in Units 7–8.
/// Enable Load = false — used only as a merge source in fact table partitions.
expression CombinedSeaRef =
		let
		    // Reference the Fabric SEA_REF table (already in the model)
		    SEA_REF = #"dbt_gold_nems_emission fact_nems__permit_kpi_to_sea",
		
		    // Union historical (2019–2025) with Fabric data (2026)
		    Combined = Table.Combine({HistoricalSeaRef, SEA_REF}),
		
		    // Sort for stable pivot column ordering
		    Sorted = Table.Sort(Combined, {{"metric", Order.Ascending}, {"field", Order.Ascending}, {"year", Order.Ascending}}),
		
		    // Determine pivot columns from the full combined metric list
		    MetricList = List.Sort(List.Distinct(Sorted[metric])),
		
		    // Pivot by metric — one row per (field, year), one column per metric
		    Pivoted = Table.Pivot(Sorted, MetricList, "metric", "value_permit_kpi", List.First)
		in
		    Pivoted
	lineageTag: d4e5f6a7-b8c9-0123-defa-234567890123

