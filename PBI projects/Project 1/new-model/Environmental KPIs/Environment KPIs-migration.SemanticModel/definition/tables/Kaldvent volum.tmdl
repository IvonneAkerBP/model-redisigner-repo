table 'Kaldvent volum'
	lineageTag: 485ce85d-4e90-400b-977c-cd662c859550

	measure 'Volume (1000 m3) QTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				TOTALQTD(SUM('Kaldvent volum'[Volume (1000 m3)]), 'Dim_Date'[Date])
			)
		lineageTag: 61146486-0e8b-403d-b310-087ec0989a22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vented KPI year' = CALCULATE(MAX('Kaldvent volum'[Tillatelse Kaldvent])*0.9,('Kaldvent volum'[Field]  IN {"Valhall", "Ula", "Hod"})) + CALCULATE(MAX('Kaldvent volum'[Tillatelse Kaldvent]), NOT ('Kaldvent volum'[Field]  IN {"Valhall", "Ula", "Hod"}))
		lineageTag: 1dfafa1a-62d0-4370-8e2a-209f8f097d1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume (1000 m3) YTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				TOTALYTD(SUM('Kaldvent volum'[Volume (1000 m3)]), 'Dim_Date'[Date].[Date])
			)
		lineageTag: ea69b967-8d5d-4be1-a333-8f78a9011837

		annotation PBI_FormatHint = {"isGeneralNumber":true}

