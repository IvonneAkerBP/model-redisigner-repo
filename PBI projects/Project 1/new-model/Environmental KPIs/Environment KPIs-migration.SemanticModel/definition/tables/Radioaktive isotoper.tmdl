	measure 'KPI year' =
			CALCULATE( MAX( 'Radioaktive isotoper'[Permits] ) * 0.9, ( 'Radioaktive isotoper'[Field] IN { "Valhall", "Ula", "Alvheim", "Skarv"} ) )
			    + CALCULATE( MAX( 'Radioaktive isotoper'[Permits] ), NOT ( 'Radioaktive isotoper'[Field] IN { "Valhall", "Ula", "Alvheim", "Skarv" } ) )
		formatString: 0.00
