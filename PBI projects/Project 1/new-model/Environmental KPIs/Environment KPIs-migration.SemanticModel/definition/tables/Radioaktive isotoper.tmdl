	partition 'Radioaktive isotoper' = m
		mode: import
		source = ```
				let
				    Source = Sql.Database(
				        "obax4o2iqosevp5oa2r6dbtune-2dhddioar5aebauc4huzjvnrve.datawarehouse.fabric.microsoft.com",
				        "wh_gold_hsseq",
				    
				    
				    [Query="
				        SELECT
				    [date] AS [Date],
				    [component_activity_bq] AS [component_activity_bq],
				    [facility] AS [Facility],
				    [field] AS [Field],
				    [component] AS [Component],
				    [stream] AS [Stream],
				    [stream_type] AS [Stream Type],
				    [stream_subtype] AS [Stream Subtype],
				    [update_date] AS [Update Date],
				    [samples] AS [Samples]
				    
				      
				   
				FROM 
				    [dbt_gold_nems_environment_kpi].[fact_nems__discharged_produced_water_analysis_radioactive_ctt]
				    
				WHERE 
				    fabric_valid_to_date = '9999-12-31 00:00:00.000000'
				
				    "]),
				    #"Sorterte rader" = Table.Sort(Source,{{"Date", Order.Descending}}),
				    #"Endret type" = Table.TransformColumnTypes(#"Sorterte rader",{{"Date", type date}, {"Update Date", type date}, {"Field", type text}, {"Facility", type text}, {"Stream Type", type text}, {"Stream Subtype", type text}, {"Stream", type text}, {"Component", type text}, {"component_activity_bq", type number}, {"Samples", Int64.Type}}),
				    #"Kolonner med nye navn" = Table.RenameColumns(#"Endret type",{{"component_activity_bq", "Component Activity (Bq)"}}),
				    #"Erstattet verdi" = Table.ReplaceValue(#"Kolonner med nye navn","PL 001B ","",Replacer.ReplaceText,{"Field"}),
				    #"År satt inn1" = Table.AddColumn(#"Erstattet verdi", "År", each Date.Year([Date]), Int64.Type),
				    #"Sammenslått kolonne satt inn1" = Table.AddColumn(#"År satt inn1", "loc_key", each Text.Combine({[Field], [Facility], Text.From([År], "nb-NO")}, "_"), type text),
				    #"Tekst med små bokstaver" = Table.TransformColumns(#"Sammenslått kolonne satt inn1",{{"loc_key", Text.Lower, type text}}),
				    #"Erstattet verdi1" = Table.ReplaceValue(#"Tekst med små bokstaver"," ","",Replacer.ReplaceText,{"loc_key"}),
				    #"Måned satt inn" = Table.AddColumn(#"Erstattet verdi1", "Måned", each Date.Month([Date]), Int64.Type),
				    #"Kolonner med nye navn1" = Table.RenameColumns(#"Måned satt inn",{{"År", "Year"}}),
				    #"Egendefinert lagt til" = Table.AddColumn(#"Kolonner med nye navn1", "Permits", each if([Component] = "226Ra") then (
				if ([Field] = "Ivar Aasen" and [Year] <2021) then (10)
				else if ([Field] = "Ivar Aasen" and [Year] >2020) then (70)
				else if ([Field] = "Skarv") then (2.676)
				else if ([Field] = "Alvheim") then (11)
				else if ([Field] = "Valhall") then (7.2)
				else if ([Field] = "Ula" and [Year]>2020) then (90)
				else if ([Field] = "Ula" and [Year]<2021) then (3.4)
				else if ([Field] = "Ula" and [Year]=2026) then (90)
				else if ([Field] = "Edvard Grieg" and [Year]>2020 and [Year]<2024) then (6)
				else if ([Field] = "Edvard Grieg" and [Year]>2023 and [Year]<2025) then (16)
				else if ([Field] = "Edvard Grieg" and [Year]=2025) then (20)
				else if ([Field] = "Edvard Grieg" and [Year]=2026) then (16)
				    else null)
				else if([Component] = "228Ra") then (
				    if ([Field] = "Ivar Aasen" and [Year]<2021) then (8.2)
				else if ([Field] = "Ivar Aasen" and [Year]>2020) then (20)
				else if ([Field] = "Skarv") then (2.23)
				else if ([Field] = "Alvheim") then (12.9)
				else if ([Field] = "Valhall") then (2.45)
				else if ([Field] = "Ula" and [Year] > 2020) then (40)
				else if ([Field] = "Ula" and [Year] < 2021) then (1.1)
				else if ([Field] = "Ula" and [Year] = 2026) then (40)
				else if ([Field] = "Edvard Grieg" and [Year] > 2020 and [Year]<2024) then (10)
				else if ([Field] = "Edvard Grieg" and [Year]>2023 and [Year]<2026) then (36)
				else if ([Field] = "Edvard Grieg" and [Year] = 2024) then (44)
				else if ([Field] = "Edvard Grieg" and [Year] = 2026) then (36)
				    else null
				)
				else if([Component] = "210Pb") then (
				    if ([Field] = "Ivar Aasen" and [Year]<2021) then (0.4)
				else if ([Field] = "Ivar Aasen" and [Year]>2020) then (0.42)
				else if ([Field] = "Skarv") then (0.312)
				else if ([Field] = "Alvheim") then (0.8)
				else if ([Field] = "Valhall") then (0.8)
				else if ([Field] = "Ula" and [Year] > 2020) then (4)
				else if ([Field] = "Ula" and [Year] < 2021) then (0.2)
				else if ([Field] = "Ula" and [Year] = 2026) then (4)
				else if ([Field] = "Edvard Grieg" and [Year] > 2020 and [Year]<2024) then (0.2)
				else if ([Field] = "Edvard Grieg" and [Year]>2023 and [Year]<2033) then (2)
				else if ([Field] = "Edvard Grieg" and [Year] > 2024) then (3)
				else if ([Field] = "Edvard Grieg" and [Year] = 2026) then (2)
				else null
				)
				else null),
				    #"Endret type1" = Table.TransformColumnTypes(#"Egendefinert lagt til",{{"Permits", type number}}),
				    #"Egendefinert lagt til1" = Table.AddColumn(#"Endret type1", "KPIs", each if [Field] = "Ula" or [Field] = "Valhall" then 
				([Permits]/12)*[Måned]*0.9
				else ([Permits]/12)*[Måned]),
				    #"Endret type2" = Table.TransformColumnTypes(#"Egendefinert lagt til1",{{"KPIs", type number}})
				in
				    #"Endret type2"
				```

