	measure 'Component Activity (Bq) MTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Rask oppretting av mål for tidsintelligens kan bare grupperes eller filtreres etter datohierarkiet eller den primære datokolonnen levert av Power BI."),
				TOTALMTD(
					SUM('Radioaktive isotoper'[Component Activity (Bq)]),
					'Dim_Date'[Date].[Date]
				)
			)/1000000000
		formatString: 0.000
		lineageTag: dcdc3ede-0619-49bf-869a-55ef95d79544

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MonthToDate"
				}

		changedProperty = FormatString

	measure 'Component Activity (Bq) YTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Rask oppretting av mål for tidsintelligens kan bare grupperes eller filtreres etter datohierarkiet eller den primære datokolonnen levert av Power BI."),
				TOTALYTD(
					SUM('Radioaktive isotoper'[Component Activity (Bq)]),
					'Dim_Date'[Date].[Date]
				)
			)/1000000000
		formatString: 0
		lineageTag: 384093bd-92fe-4f11-83df-ad00f5bee366

