	measure 'NOx KPI year' = 
			CALCULATE(
				MAX('Emissions to air'[KPI NOx]),
				('Emissions to air'[Field] IN {
					"Ula",
					"Hod",
					"Skarv"
				})
			)
			+ CALCULATE(
				MAX('Emissions to air'[KPI NOx]) * 12 / MONTH(LASTDATE('Emissions to air'[Time_Id])),
				('Emissions to air'[Field] IN {
					"Valhall",
					"Alvheim",
					"Edvard Grieg",
					"Ivar Aasen"
				})
			)
			+ CALCULATE(
				MAX('Emissions to air'[Tillatelse NOx]),
				NOT ('Emissions to air'[Field] IN {
					"Valhall",
					"Ula",
					"Hod",
					"Skarv",
					"Alvheim",
					"Edvard Grieg",
					"Ivar Aasen"
				})
			)
		lineageTag: 3f20d01b-8b49-47a3-ac4b-1f559f4332e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'nmVOCfuel KPI year' = 
			CALCULATE(
				MAX('Emissions to air'[Permit nmVOC]) * 0.9,
				('Emissions to air'[Field] IN {
					"Valhall"
				})
			) + CALCULATE(
				MAX('Emissions to air'[Permit nmVOC]),
				NOT ('Emissions to air'[Field] IN {
					"Valhall"
				})
			)
		lineageTag: dfb7ca73-203f-4d04-9f3b-3b68376c7879

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure yaxis_co2 = [CO2 Emissions YTD] + 3000
		lineageTag: e1615968-0037-40da-b995-136e88cae124

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'nmVOC_KPI year' = MAX('Emissions to air'[KPI nmVOC]) * 12 / MONTH(LASTDATE('Emissions to air'[Time_Id]))
		lineageTag: 248c988d-5bf2-469f-9ca6-b594fe8a58b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CO2 KPI year' = 
			DIVIDE(
				MAX('Emissions to air'[KPI CO2 tonn]),
				MAX('Emissions to air'[Month])
			) * 12
		lineageTag: 0e2d2626-5a0d-4e54-97fc-2603696a0141

		annotation PBI_FormatHint = {"isGeneralNumber":true}

