	partition 'Emissions to air-64c6f1ee-34af-4e19-b817-6e8089dfec19' = m
		mode: import
		source = ```
				let
					Source = Sql.Database(
						"obax4o2iqosevp5oa2r6dbtune-2dhddioar5aebauc4huzjvnrve.datawarehouse.fabric.microsoft.com",
						"wh_gold_hsseq",
						[
							Query = "WITH CTE AS (  -- målinger/utslipp fra Nems
								    SELECT 
								        CAST([date] AS date) AS Time_Id,
								        CASE 
								            WHEN field = 'Fenris'                THEN 'Valhall'
								            WHEN field = 'PL 001B Ivar Aasen'    THEN 'Ivar Aasen'
								            WHEN field = 'HANZ'                  THEN 'Ivar Aasen'
								            WHEN field = 'Tambar'                THEN 'Ula'
								            WHEN field = 'Alve Nord'             THEN 'Skarv'
								            WHEN field = 'Idun Nord'             THEN 'Skarv'
								            WHEN field = 'Ørn'                   THEN 'Skarv'
								            WHEN field = 'Symra'                 THEN 'Ivar Aasen'
								            WHEN field = 'Solveig'               THEN 'Edvard Grieg'
								            ELSE field
								        END AS Field,
								        CASE 
								            WHEN (field = 'Fenris'    AND facility = 'Noble Integrator')   THEN 'Fenris/Noble Integrator'
								            WHEN (field = 'Tambar'    AND facility = 'Noble Invincible')   THEN 'Tambar/Noble Invincible'
								            WHEN (field = 'Alve Nord' AND facility = 'Scarabeo 8')         THEN 'Alve Nord/Scarabeo 8'
								            WHEN (field = 'Idun Nord' AND facility = 'Scarabeo 8')         THEN 'Idun Nord/Scarabeo 8'
								            WHEN (field = 'Ørn' AND facility = 'Scarabeo 8')               THEN 'Ørn/Scarabeo 8'
								            WHEN (field = 'Symra'     AND facility = 'Deepsea Nordkapp')   THEN 'Symra/Deepsea Nordkapp'
								            WHEN (field = 'Solveig'   AND facility = 'Deepsea Nordkapp')   THEN 'Solveig/Deepsea Nordkapp'
								            ELSE facility
								        END AS Facility,
								        [emissions_source]         AS [Emissions Source],
								        [stream_subtype]           AS [Stream Subtype],
								        [source_details]           AS [Source Details],
								        [co2_emissions_tonnes]*1000     AS [CO2 Emissions],
								        [nox_emissions_tonnes]     AS [NOx Emissions],
								        [ch4_emissions_tonnes]     AS [CH4 Emissions],
								        [nmvoc_emissions_tonnes]   AS [NMVOC Emissions],
								        [sox_emissions_tonnes]     AS [SOx Emissions],
								        [volume_m3]               AS [Volume],
								        [energy_mwh]               AS [Energy],
								        DATEPART(QUARTER, [date])  AS [QuarterNum],
								        DATEPART(YEAR,    [date])  AS [YearNum],
								        DATEPART(MONTH,   [date])  AS [MonthNum]
								    FROM [dbt_gold_nems_environment_kpi].[fact_nems__environment_kpi_emission_to_air_ctt] 
								    WHERE 
								    fabric_valid_to_date = '9999-12-31 00:00:00.000000'
								
								    UNION ALL
								
								    SELECT 
								        CAST([date] AS date) AS Time_Id,
								        CASE WHEN field = 'Hod' THEN 'Valhall' ELSE field END AS Field,
								        facility AS Facility,
								        [emissions_source]       AS [Emissions Source],
								        [stream_subtype]         AS [Stream Subtype],
								        [source_details]         AS [Source Details],
								        [co2_emissions_tonnes]*1000   AS [CO2 Emissions],
								        NULL                     AS [NOx Emissions],
								        NULL                     AS [CH4 Emissions],
								        NULL                     AS [NMVOC Emissions],
								        NULL                     AS [SOx Emissions],
								        NULL                     AS [Volume],
								        NULL                     AS [Energy],
								        DATEPART(QUARTER, [date]) AS [QuarterNum],
								        DATEPART(YEAR,    [date]) AS [YearNum],
								        DATEPART(MONTH,   [date]) AS [MonthNum]
								    FROM [dbt_gold_nems_environment_kpi].[fact_nems__environment_kpi_emission_to_air_ctt]
								    WHERE field = 'Hod' AND 
								    fabric_valid_to_date = '9999-12-31 00:00:00.000000'
								),
								Tillatelse_flaring AS (  -- tillatelse for flaring
								    SELECT 
								        CTE.*,
								        CASE 
								            -- Ula
								            WHEN Field = 'Ula' AND [YearNum]=2019 AND [QuarterNum]=1 THEN 1640000
								            WHEN Field = 'Ula' AND [YearNum]=2019 AND [QuarterNum]=2 THEN 1640000
								            WHEN Field = 'Ula' AND [YearNum]=2019 AND [QuarterNum]=3 THEN 1640000
								            WHEN Field = 'Ula' AND [YearNum]=2019 AND [QuarterNum]=4 THEN 1640000
								            WHEN Field = 'Ula' AND [YearNum]=2020 AND [QuarterNum]=1 THEN 1800000
								            WHEN Field = 'Ula' AND [YearNum]=2020 AND [QuarterNum]=2 THEN 1820000
								            WHEN Field = 'Ula' AND [YearNum]=2020 AND [QuarterNum]=3 THEN 1840000
								            WHEN Field = 'Ula' AND [YearNum]=2020 AND [QuarterNum]=4 THEN 1840000
								            WHEN Field = 'Ula' AND [YearNum]=2021 AND [QuarterNum]=1 THEN 1540000
								            WHEN Field = 'Ula' AND [YearNum]=2021 AND [QuarterNum]=2 THEN 1860000
								            WHEN Field = 'Ula' AND [YearNum]=2021 AND [QuarterNum]=3 THEN 1560000
								            WHEN Field = 'Ula' AND [YearNum]=2021 AND [QuarterNum]=4 THEN 1560000
								            WHEN Field = 'Ula' AND [YearNum]=2022 AND [QuarterNum]=1 THEN 1540000
								            WHEN Field = 'Ula' AND [YearNum]=2022 AND [QuarterNum]=2 THEN 1860000
								            WHEN Field = 'Ula' AND [YearNum]=2022 AND [QuarterNum]=3 THEN 1560000
								            WHEN Field = 'Ula' AND [YearNum]=2022 AND [QuarterNum]=4 THEN 1560000
								            WHEN Field = 'Ula' AND [YearNum]=2023 AND [QuarterNum]=1 THEN 1420000
								            WHEN Field = 'Ula' AND [YearNum]=2023 AND [QuarterNum]=2 THEN 1651000
								            WHEN Field = 'Ula' AND [YearNum]=2023 AND [QuarterNum]=3 THEN 2112000
								            WHEN Field = 'Ula' AND [YearNum]=2023 AND [QuarterNum]=4 THEN 1442000
								            WHEN Field = 'Ula' AND [YearNum]=2024 AND [QuarterNum]=1 THEN 1420000
								            WHEN Field = 'Ula' AND [YearNum]=2024 AND [QuarterNum]=2 THEN 1651000
								            WHEN Field = 'Ula' AND [YearNum]=2024 AND [QuarterNum]=3 THEN 1812000
								            WHEN Field = 'Ula' AND [YearNum]=2024 AND [QuarterNum]=4 THEN 1442000
								            WHEN Field = 'Ula' AND [YearNum]=2025 THEN 5514000
								            WHEN Field = 'Ula' AND [YearNum]=2026 THEN 4928000
								
								            -- Skarv
								            WHEN Field = 'Skarv' AND [YearNum]=2020 AND [QuarterNum]=1 THEN 1080000
								            WHEN Field = 'Skarv' AND [YearNum]=2020 AND [QuarterNum]=2 THEN 2057000
								            WHEN Field = 'Skarv' AND [YearNum]=2020 AND [QuarterNum]=3 THEN 5000000
								            WHEN Field = 'Skarv' AND [YearNum]=2020 AND [QuarterNum]=4 THEN 3500000
								            WHEN Field = 'Skarv' AND [YearNum]=2021 AND [QuarterNum]=1 THEN 1080000
								            WHEN Field = 'Skarv' AND [YearNum]=2021 AND [QuarterNum]=2 THEN 2057000
								            WHEN Field = 'Skarv' AND [YearNum]=2021 AND [QuarterNum]=3 THEN 5000000
								            WHEN Field = 'Skarv' AND [YearNum]=2021 AND [QuarterNum]=4 THEN 3500000
								            WHEN Field = 'Skarv' AND [YearNum]=2022 AND [QuarterNum]=1 THEN 1069000
								            WHEN Field = 'Skarv' AND [YearNum]=2022 AND [QuarterNum]=2 THEN 1057000
								            WHEN Field = 'Skarv' AND [YearNum]=2022 AND [QuarterNum]=3 THEN 1081000
								            WHEN Field = 'Skarv' AND [YearNum]=2022 AND [QuarterNum]=4 THEN 1081000
								            WHEN Field = 'Skarv' AND [YearNum]=2023 AND [QuarterNum]=1 THEN 1000000
								            WHEN Field = 'Skarv' AND [YearNum]=2023 AND [QuarterNum]=2 THEN 1000000
								            WHEN Field = 'Skarv' AND [YearNum]=2023 AND [QuarterNum]=3 THEN 5000000
								            WHEN Field = 'Skarv' AND [YearNum]=2023 AND [QuarterNum]=4 THEN 1000000
								            WHEN Field = 'Skarv' AND [YearNum]=2024 AND [QuarterNum]=1 THEN 750000
								            WHEN Field = 'Skarv' AND [YearNum]=2024 AND [QuarterNum]=2 THEN 750000
								            WHEN Field = 'Skarv' AND [YearNum]=2024 AND [QuarterNum]=3 THEN 950000
								            WHEN Field = 'Skarv' AND [YearNum]=2024 AND [QuarterNum]=4 THEN 750000
								            WHEN Field = 'Skarv' AND [YearNum]=2025 THEN 3240000
								            WHEN Field = 'Skarv' AND [YearNum]=2026 THEN 3240000
								            -- Valhall
								            WHEN Field = 'Valhall' AND [YearNum]=2020 AND [QuarterNum]=1 THEN 810000
								            WHEN Field = 'Valhall' AND [YearNum]=2020 AND [QuarterNum]=2 THEN 1183000
								            WHEN Field = 'Valhall' AND [YearNum]=2020 AND [QuarterNum]=3 THEN 828000
								            WHEN Field = 'Valhall' AND [YearNum]=2020 AND [QuarterNum]=4 THEN 1012000
								            WHEN Field = 'Valhall' AND [YearNum]=2021 AND [QuarterNum]=1 THEN 810000
								            WHEN Field = 'Valhall' AND [YearNum]=2021 AND [QuarterNum]=2 THEN 1183000
								            WHEN Field = 'Valhall' AND [YearNum]=2021 AND [QuarterNum]=3 THEN 828000
								            WHEN Field = 'Valhall' AND [YearNum]=2021 AND [QuarterNum]=4 THEN 1012000
								            WHEN Field = 'Valhall' AND [YearNum]=2022 AND [QuarterNum]=1 THEN 675000
								            WHEN Field = 'Valhall' AND [YearNum]=2022 AND [QuarterNum]=2 THEN 2200000
								            WHEN Field = 'Valhall' AND [YearNum]=2022 AND [QuarterNum]=3 THEN 2200000
								            WHEN Field = 'Valhall' AND [YearNum]=2022 AND [QuarterNum]=4 THEN 2400000
								            WHEN Field = 'Valhall' AND [YearNum]=2023 AND [QuarterNum]=1 THEN 2000000
								            WHEN Field = 'Valhall' AND [YearNum]=2023 AND [QuarterNum]=2 THEN 2000000
								            WHEN Field = 'Valhall' AND [YearNum]=2023 AND [QuarterNum]=3 THEN 2026000
								            WHEN Field = 'Valhall' AND [YearNum]=2023 AND [QuarterNum]=4 THEN 2026000
								            WHEN Field = 'Valhall' AND [YearNum]=2024 AND [QuarterNum]=1 THEN 2221000
								            WHEN Field = 'Valhall' AND [YearNum]=2024 AND [QuarterNum]=2 THEN 2026000
								            WHEN Field = 'Valhall' AND [YearNum]=2024 AND [QuarterNum]=3 THEN 1087000
								            WHEN Field = 'Valhall' AND [YearNum]=2024 AND [QuarterNum]=4 THEN 1087000
								            WHEN Field = 'Valhall' AND [YearNum]=2025 THEN 3057000
								            WHEN Field = 'Valhall' AND [YearNum]=2026 THEN 2246000
								            -- Alvheim
								            WHEN Field = 'Alvheim' AND [YearNum]=2020 AND [QuarterNum]=1 THEN 3960000
								            WHEN Field = 'Alvheim' AND [YearNum]=2020 AND [QuarterNum]=2 THEN 1840000
								            WHEN Field = 'Alvheim' AND [YearNum]=2020 AND [QuarterNum]=3 THEN 1840000
								            WHEN Field = 'Alvheim' AND [YearNum]=2020 AND [QuarterNum]=4 THEN 1840000
								            WHEN Field = 'Alvheim' AND [YearNum]=2021 AND [QuarterNum]=1 THEN 1692000
								            WHEN Field = 'Alvheim' AND [YearNum]=2021 AND [QuarterNum]=2 THEN 1692000
								            WHEN Field = 'Alvheim' AND [YearNum]=2021 AND [QuarterNum]=3 THEN 1692000
								            WHEN Field = 'Alvheim' AND [YearNum]=2021 AND [QuarterNum]=4 THEN 1692000
								            WHEN Field = 'Alvheim' AND [YearNum]=2022 AND [QuarterNum]=1 THEN 1250000
								            WHEN Field = 'Alvheim' AND [YearNum]=2022 AND [QuarterNum]=2 THEN 1250000
								            WHEN Field = 'Alvheim' AND [YearNum]=2022 AND [QuarterNum]=3 THEN 1250000
								            WHEN Field = 'Alvheim' AND [YearNum]=2022 AND [QuarterNum]=4 THEN 1250000
								            WHEN Field = 'Alvheim' AND [YearNum]=2023 AND [QuarterNum]=1 THEN 1750000
								            WHEN Field = 'Alvheim' AND [YearNum]=2023 AND [QuarterNum]=2 THEN 750000
								            WHEN Field = 'Alvheim' AND [YearNum]=2023 AND [QuarterNum]=3 THEN 795000
								            WHEN Field = 'Alvheim' AND [YearNum]=2023 AND [QuarterNum]=4 THEN 12750000
								            WHEN Field = 'Alvheim' AND [YearNum]=2024 AND [QuarterNum]=1 THEN 750000
								            WHEN Field = 'Alvheim' AND [YearNum]=2024 AND [QuarterNum]=2 THEN 1500000
								            WHEN Field = 'Alvheim' AND [YearNum]=2024 AND [QuarterNum]=3 THEN 750000
								            WHEN Field = 'Alvheim' AND [YearNum]=2024 AND [QuarterNum]=4 THEN 750000
								            WHEN Field = 'Alvheim' AND [YearNum]=2025 THEN 3000000
								            WHEN Field = 'Alvheim' AND [YearNum]=2026 THEN 3000000
								            -- Ivar Aasen
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2020 AND [QuarterNum]=1 THEN 1350000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2020 AND [QuarterNum]=2 THEN 1270000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2020 AND [QuarterNum]=3 THEN 1770000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2020 AND [QuarterNum]=4 THEN 920000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2021 AND [QuarterNum]=1 THEN 1350000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2021 AND [QuarterNum]=2 THEN 1270000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2021 AND [QuarterNum]=3 THEN 1288000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2021 AND [QuarterNum]=4 THEN 1288000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2022 AND [QuarterNum]=1 THEN 913000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2022 AND [QuarterNum]=2 THEN 913000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2022 AND [QuarterNum]=3 THEN 1643000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2022 AND [QuarterNum]=4 THEN 1643000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2023 AND [QuarterNum]=1 THEN 2000000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2023 AND [QuarterNum]=2 THEN 500000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2023 AND [QuarterNum]=3 THEN 1000000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2023 AND [QuarterNum]=4 THEN 1000000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2024 AND [QuarterNum]=1 THEN 1175000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2024 AND [QuarterNum]=2 THEN 1175000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2024 AND [QuarterNum]=3 THEN 875000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2024 AND [QuarterNum]=4 THEN 875000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2025 THEN 2375000
								            WHEN Field = 'Ivar Aasen' AND [YearNum]=2026 THEN 3400000
								            -- Edvard Grieg
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=1 THEN 1990000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=2 THEN 2291000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=3 THEN 1992000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=4 THEN 2292000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2023 THEN 54000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2024 THEN 1300000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2025 THEN 4711000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2026 THEN 3716000
								        END AS [Tillatelse flaring]
								    FROM CTE
								),
								t AS (
								    SELECT 
								        tf.*,
								        CASE 
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2023 AND [QuarterNum]=1 THEN 1850000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2023 AND [QuarterNum]=2 THEN 1500000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2023 AND [QuarterNum]=3 THEN 1500000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2023 AND [QuarterNum]=4 THEN 1500000
								            WHEN Field = 'Edvard Grieg' AND [YearNum]=2026 THEN CAST([Tillatelse flaring]*0.9 AS decimal(18,2)) 
								
								            WHEN Field = 'Ivar Aasen'   AND [YearNum]=2026 THEN CAST([Tillatelse flaring]*0.9 AS decimal(18,2)) 
								
								            WHEN Field = 'Ula'          AND [YearNum]=2023 AND [QuarterNum]=1 THEN 1140000
								            WHEN Field = 'Ula'          AND [YearNum]=2023 AND [QuarterNum]=2 THEN 1320000
								            WHEN Field = 'Ula'          AND [YearNum]=2023 AND [QuarterNum]=3 THEN 1690000
								            WHEN Field = 'Ula'          AND [YearNum]=2023 AND [QuarterNum]=4 THEN 1150000
								            WHEN Field = 'Ula'          AND [YearNum]=2024 AND [QuarterNum]=1 THEN CAST([Tillatelse flaring]*0.9 AS decimal(18,2))  -- 10% lavere enn tillatelsen
								            WHEN Field = 'Ula'          AND [YearNum]=2024 AND [QuarterNum]<>1 THEN CAST([Tillatelse flaring]*0.8 AS decimal(18,2)) -- 20% lavere enn tillatelsen
								            WHEN Field = 'Ula'          AND [YearNum]=2025 THEN CAST([Tillatelse flaring]*0.8 AS decimal(18,2))                   -- 20% lavere enn tillatelsen
								            WHEN Field = 'Ula'          AND [YearNum]=2026 THEN CAST([Tillatelse flaring]*0.9 AS decimal(18,2))                   -- 10% lavere enn tillatelsen
								            
								            WHEN Field = 'Alvheim'      AND [YearNum]=2023 AND [QuarterNum]=1 THEN 1750000
								            WHEN Field = 'Alvheim'      AND [YearNum]=2023 AND [QuarterNum]=2 THEN 750000
								            WHEN Field = 'Alvheim'      AND [YearNum]=2023 AND [QuarterNum]=3 THEN 750000
								            WHEN Field = 'Alvheim'      AND [YearNum]=2023 AND [QuarterNum]=4 THEN 750000
								            WHEN Field = 'Alvheim'      AND [YearNum]=2025 THEN [Tillatelse flaring] -- lik tillatelsen
								            WHEN Field = 'Alvheim'      AND [YearNum]=2026 THEN [Tillatelse flaring] -- lik tillatelsen
								            
								            WHEN Field = 'Valhall'      AND [YearNum]>2022 THEN CAST([Tillatelse flaring]*0.9 AS decimal(18,2))                  -- 10% lavere enn tillatelsen
								            
								            WHEN Field = 'Skarv'        AND [YearNum]=2026 THEN 3000000
								            
								            ELSE CAST([Tillatelse flaring] AS decimal(18,2))
								        END AS [Division]  -- for beregning av KPI per kvartal
								    FROM Tillatelse_flaring tf
								),
								flaring_qtd AS (
								    SELECT 
								        t.*,
								        CASE 
								            WHEN [QuarterNum]=1 AND [YearNum]<2025 THEN CAST(t.[Division] * [MonthNum]/3       AS decimal(18,2))
								            WHEN [QuarterNum]=2 AND [YearNum]<2025 THEN CAST(t.[Division] * ([MonthNum]-3)/3  AS decimal(18,2))
								            WHEN [QuarterNum]=3 AND [YearNum]<2025 THEN CAST(t.[Division] * ([MonthNum]-6)/3  AS decimal(18,2))
								            WHEN [QuarterNum]=4 AND [YearNum]<2025 THEN CAST(t.[Division] * ([MonthNum]-9)/3  AS decimal(18,2))
								            WHEN [YearNum]>2024                     THEN CAST(t.[Division] * ([MonthNum])/12  AS decimal(18,2))
								        END AS [KPI flaring]  -- KPI QTD
								    FROM t
								),
								TillatelseFlaring_KPInox AS (
								    SELECT 
								        qtd.*,
								        CAST(
								            CASE  -- NOX tillatelse
								                
								                WHEN Field = 'Valhall' AND Facility  = 'VALHALL PH' AND [YearNum]=2026                      THEN 75
								                WHEN Field = 'Valhall' AND Facility  <> 'VALHALL PH' AND [YearNum]=2026                      THEN 780
								                WHEN Field = 'Valhall' AND Facility <> 'VALHALL PH' AND Facility <> 'Hod A'                 THEN 780
								                WHEN Field = 'Valhall' AND Facility  = 'VALHALL PH' AND [YearNum]<2024                      THEN 320
								                WHEN Field = 'Valhall' AND Facility  = 'VALHALL PH' AND [YearNum]>2023                      THEN 75
								                
								                WHEN Facility = 'Hod A'                                                                     THEN 11
								                
								                WHEN Field = 'Ula' AND Facility = 'ULA PP' AND [YearNum]<2023                               THEN 1159
								                WHEN Field = 'Ula' AND Facility = 'ULA PP' AND [YearNum]>2022                               THEN 655
								                WHEN Field = 'Ula' AND Facility <> 'ULA PP' AND [YearNum]>2022                              THEN 496
								                
								                WHEN Field = 'Edvard Grieg' AND [YearNum]<2023                                              THEN 321
								                WHEN Field = 'Edvard Grieg' AND [YearNum]=2023                                              THEN 144
								                WHEN Field = 'Edvard Grieg' AND Facility = 'Edvard Grieg' AND [YearNum]=2026                    THEN 56
								                WHEN Field = 'Edvard Grieg' AND Facility <> 'Edvard Grieg' AND [YearNum]=2026                   THEN 168
								                WHEN Field = 'Edvard Grieg' AND Facility <> 'Edvard Grieg' AND [YearNum]>2022               THEN 117
								                WHEN Field = 'Edvard Grieg' AND Facility  = 'Edvard Grieg' AND [YearNum]>2022               THEN 56
								
								                WHEN Field = 'Skarv' AND Facility = 'Skarv FPSO' AND [YearNum]=2026                         THEN 400
								                WHEN Field = 'Skarv' AND Facility <> 'Skarv FPSO' AND [YearNum]=2026                        THEN 598                
								                WHEN Field = 'Skarv' AND Facility = 'Skarv FPSO'                                            THEN 340
								                WHEN Field = 'Skarv' AND Facility <> 'Skarv FPSO'                                           THEN 396
								                
								                WHEN Field = 'Alvheim' AND Facility = 'Alvheim FPSO'                                        THEN 360
								                WHEN Field = 'Alvheim' AND Facility <> 'Alvheim FPSO'                                       THEN 662
								                                
								                WHEN Field = 'Ivar Aasen' AND Facility = 'Ivar Aasen' AND [YearNum]=2026                    THEN 293
								                WHEN Field = 'Ivar Aasen' AND Facility <> 'Ivar Aasen' AND [YearNum]=2026                   THEN 352
								                
								                WHEN Field = 'Ivar Aasen' AND Facility = 'Ivar Aasen'                                       THEN 293
								                WHEN Field = 'Ivar Aasen' AND Facility <> 'Ivar Aasen' AND [YearNum]<2023                   THEN 66
								                WHEN Field = 'Ivar Aasen' AND Facility <> 'Ivar Aasen' AND [YearNum]>2022                   THEN 170
								                WHEN Field = 'Ivar Aasen' AND Facility = 'Ivar Aasen'                                       THEN 293
								                WHEN Field = 'Ivar Aasen' AND Facility <> 'Ivar Aasen' AND [YearNum]<2023                   THEN 66
								                WHEN Field = 'Ivar Aasen' AND Facility <> 'Ivar Aasen' AND [YearNum]=2026                   THEN 352
								
								            END AS float
								        ) AS [Tillatelse NOx]
								    FROM flaring_qtd qtd
								),
								KPI_NOx_CO2boe AS (
								    SELECT 
								        tfk.*,
								        -- NOx KPI pr mnd
								        CAST(
								            CASE
								                
								                WHEN (Field = 'Alvheim' AND Facility = 'Alvheim FPSO' AND [YearNum]=2026)                              THEN ([Tillatelse NOx]/12 * [MonthNum] * 0.9)
								                WHEN (Field = 'Alvheim' AND Facility <> 'Alvheim FPSO' AND [YearNum]=2026)                             THEN 0
								                WHEN (Field = 'Alvheim' AND Facility <> 'Alvheim FPSO' AND [YearNum]>2024)                           THEN (200*[MonthNum]/CONVERT(decimal(4,2),12))           -- KPI 200
								                WHEN (Field = 'Alvheim' AND Facility <> 'Alvheim FPSO' AND [YearNum]<2025)                           THEN ([Tillatelse NOx]/12 * [MonthNum])
								                WHEN (Field = 'Alvheim' AND Facility  = 'Alvheim FPSO')                                              THEN ([Tillatelse NOx]/12 * [MonthNum])
								                
								                WHEN Field = 'Ivar Aasen' AND Facility = 'Ivar Aasen' AND [YearNum]=2026                             THEN (10.0/12.0 * [MonthNum])
								                WHEN Field = 'Ivar Aasen' AND Facility <> 'Ivar Aasen' AND [YearNum]=2026                            THEN (120.0/12.0 * [MonthNum])
								                
								                WHEN Field = 'Edvard Grieg' AND Facility = 'Edvard Grieg' AND [YearNum]=2026                         THEN (25.0/12.0 * [MonthNum])
								                WHEN Field = 'Edvard Grieg' AND Facility <> 'Edvard Grieg' AND [YearNum]=2026                        THEN (120.0/12.0 * [MonthNum])
								                
								                WHEN Field = 'Skarv' AND Facility = 'Skarv FPSO' AND [YearNum]=2026                                   THEN ([Tillatelse NOx]/12 * [MonthNum] * 0.9)
								                WHEN Field = 'Skarv' AND Facility <> 'Skarv FPSO' AND [YearNum]=2026                                  THEN  (538.0/12.0 * [MonthNum])
								                
								                WHEN (Field = 'Valhall' AND [YearNum]>2022 AND [YearNum]<2025)                                        THEN ([Tillatelse NOx]/12 * [MonthNum] * 0.9)            -- 10% lavere
								                WHEN (Field = 'Valhall' AND Facility = 'VALHALL PH' AND [YearNum]=2025)                               THEN (50*[MonthNum]/CONVERT(decimal(4,2),12))             -- 50 tonn
								                WHEN (Field = 'Valhall' AND Facility <> 'VALHALL PH' AND [YearNum]=2025)                              THEN (100*[MonthNum]/CONVERT(decimal(4,2),12))            -- 100 tonn
								                WHEN (Field = 'Valhall' AND Facility = 'VALHALL PH' AND [YearNum]=2026)                               THEN ([Tillatelse NOx]/12 * [MonthNum] * 0.9) 
								                WHEN (Field = 'Valhall' AND Facility <> 'VALHALL PH' AND [YearNum]=2026)                              THEN ([Tillatelse NOx]/12 * [MonthNum] * 0.9)
								
								
								                WHEN Field = 'Ula' AND Facility = 'ULA PP' AND [YearNum]=2026                               THEN 430
								                WHEN Field = 'Ula' AND Facility <> 'ULA PP' AND [YearNum]=2026                              THEN 0                
								                WHEN (Field = 'Ula' AND [YearNum]>2022)                                                                THEN ([Tillatelse NOx]/12 * [MonthNum] * 0.9)            -- 10% lavere
								                
								                WHEN (Field = 'Hod' AND [YearNum]>2022)                                                                THEN ([Tillatelse NOx]/12 * [MonthNum] * 0.9)            -- 10% lavere
								                
								                WHEN (Field = 'Skarv' AND [YearNum]=2026)                                                               THEN 360 
								
								                WHEN (Field = 'Skarv' OR (Field = 'Ivar Aasen' AND [YearNum]<>2026) OR (Field='Edvard Grieg' AND [YearNum]<>2026) )  THEN ([Tillatelse NOx]/12 * [MonthNum])
								            END AS float
								        ) AS [KPI NOx],
								
								        -- Vented gas calc
								        ([CH4 Emissions] + [NMVOC Emissions]) / 1000.0 AS [Cold ventilated gas],
								
								        -- Permits
								        CASE
								            WHEN Field='Ivar Aasen'                         THEN 97
								            WHEN Field='Alvheim' AND [YearNum]<2025         THEN 477
								            WHEN Field='Alvheim' AND [YearNum]=2025         THEN 263
								            WHEN Field='Skarv'   AND [YearNum]<2025         THEN 2688
								            WHEN Field='Skarv'   AND [YearNum]=2025         THEN 109
								            WHEN Field='Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=1 THEN 52000
								            WHEN Field='Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=2 THEN 59000
								            WHEN Field='Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=3 THEN 52000
								            WHEN Field='Edvard Grieg' AND [YearNum]=2022 AND [QuarterNum]=4 THEN 58000
								            WHEN Field='Edvard Grieg' AND [YearNum]=2023 THEN 54000
								            WHEN Field='Valhall'      AND [YearNum]=2025 THEN 18000
								            WHEN Field='Edvard Grieg' AND [YearNum]=2026 THEN 54000
								            ELSE NULL
								        END AS [Permit Cold ventilated gas]
								
								    -- Unit 3 Phase B: [Permit nmVOC] removed from SQL (sourced from CombinedAirRef via Power Query)
								    FROM TillatelseFlaring_KPInox tfk
								),
								t2 AS (
								    SELECT 
								        k.*,
								        [Permit Cold ventilated gas]/12.0 * [MonthNum] AS [KPI Cold ventilated gas],
								        -- Unit 3 Phase B: [KPI nmVOC] removed from SQL (sourced from CombinedAirRef via Power Query)
								        CONCAT_WS('_', k.Field, k.Facility) AS [loc_key]
								    FROM KPI_NOx_CO2boe k
								)
								
								SELECT 
								    t2.*,
								    t2.[YearNum]    AS [Year],      -- compatibility alias
								    t2.[QuarterNum] AS [Quarter],   -- compatibility alias
								    t2.[MonthNum]   AS [Month]      -- compatibility alias
								FROM t2
								ORDER BY Time_Id DESC;
								
								"
						]
					),
					#"Changed Type" = Table.TransformColumnTypes(Source, {{"Time_Id", type date}}),
					#"Rounded Up" = Table.TransformColumns(#"Changed Type", {{"KPI flaring", Number.RoundUp, Int64.Type}}),
					#"Sammenslått kolonne satt inn" = Table.AddColumn(
						#"Rounded Up", "loc_key.1", each Text.Combine({[loc_key], Text.From([Year], "nb-NO")}, "_"), type text
					),
					#"Erstattet verdi" = Table.ReplaceValue(
						#"Sammenslått kolonne satt inn", " ", "", Replacer.ReplaceText, {"loc_key.1"}
					),
					#"Tekst med små bokstaver" = Table.TransformColumns(#"Erstattet verdi", {{"loc_key.1", Text.Lower, type text}}),
					#"Fjernede kolonner" = Table.RemoveColumns(#"Tekst med små bokstaver", {"loc_key"}),
					#"Kolonner med nye navn" = Table.RenameColumns(#"Fjernede kolonner", {{"loc_key.1", "loc_key"}}),
					// Unit 1 Phase B — CO₂ Emissions
					// [KPI CO2 tonn] is now sourced from CombinedAirRef (via HistoricalAirRef + AIR_REF).
					// The SQL CASE block for [KPI CO2 tonn] has been removed from the SQL query above.
					// Proration (/12 × MonthNum) is applied for years ≥ 2025 to match the former SQL formula.
					#"Merged CombinedAirRef" = Table.NestedJoin(
						#"Kolonner med nye navn", {"Field", "YearNum"}, CombinedAirRef, {"field", "year"}, "_CombinedAirRef",
						JoinKind.LeftOuter
					),
					// Unit 3 Phase A/B — extend existing expand to include nmVOC columns
					#"Expanded Annual" = Table.ExpandTableColumn(
						#"Merged CombinedAirRef",
						"_CombinedAirRef",
						{"CO2 KPI Year", "Mainfield nmVOC Permit", "Rig nmVOC Permit", "Mainfield nmVOC KPI", "Rig nmVOC KPI"},
						{"_CO2KPIAnnual", "_MFnmVOCPermit", "_RignmVOCPermit", "_MFnmVOCKPI", "_RignmVOCKPI"}
					),
					#"Added CO2 KPI" = Table.AddColumn(
						#"Expanded Annual",
						"KPI CO2 tonn",
						each if [YearNum] >= 2025 then [_CO2KPIAnnual] / 12 * [MonthNum] else [_CO2KPIAnnual],
						type number
					),
					// Rig routing: VALHALL PH / Hod A (Valhall), Ivar Aasen, Alvheim FPSO,
					//   Skarv FPSO, Edvard Grieg, ULA PP treated as main platform (IsRig = false).
					// All other facilities receive Rig nmVOC values.
					#"Added IsRig" = Table.AddColumn(
						#"Added CO2 KPI",
						"_IsRig",
						each
							not (
								([Field] = "Valhall" and ([Facility] = "VALHALL PH" or [Facility] = "Hod A"))
								or ([Field] = "Ivar Aasen" and [Facility] = "Ivar Aasen")
								or ([Field] = "Alvheim" and [Facility] = "Alvheim FPSO")
								or ([Field] = "Skarv" and [Facility] = "Skarv FPSO")
								or ([Field] = "Edvard Grieg" and [Facility] = "Edvard Grieg")
								or ([Field] = "Ula" and [Facility] = "ULA PP")
							),
						type logical
					),
					#"Added Permit nmVOC REF" = Table.AddColumn(
						#"Added IsRig",
						"Permit nmVOC REF",
						// Hod A: legacy SQL intentionally excluded this facility — preserve NULL (DR Option A)
