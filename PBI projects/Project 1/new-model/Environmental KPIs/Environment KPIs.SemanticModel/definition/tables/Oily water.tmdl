table 'Oily water'
	lineageTag: bc1a2946-188c-4852-83d5-76178a2203ad

	measure Reinjectiongrade =
			
			CALCULATE(
			DIVIDE(
				SUM('Oily water'[Injected Volume]),
				SUM('Oily water'[Production Volume])
			), 'Oily water'[Stream Type]="Produced water")
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8702e2c9-4479-47bc-8312-ecac3707261a

		changedProperty = FormatString

	measure 'KPI reinjected' = MAX('Oily water'[KPI water reinjected])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 021bf095-7157-4177-ab16-7b14cdd9c9c1

		changedProperty = FormatString

	measure 'Discharged Oil Mass ISO (mg) divided by Discharged Volume (L)' =
			
			DIVIDE(
				SUM('Oily water'[Discharged Oil Mass ISO (mg)]),
				SUM('Oily water'[Discharged Volume (L)])
			)
		formatString: 0
		lineageTag: 364fb9c1-4e9b-49f5-9982-50e4bf995038

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Discharged Oil Mass ISO (mg) YTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				TOTALYTD(
					SUM('Oily water'[Discharged Oil Mass ISO (mg)]),
					'Dim_Date'[Date].[Date]
				)
			)
		lineageTag: b8babde2-09cf-46b2-ae83-a2752e380c0e

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "YearToDate"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Discharged Oil Mass ISO (mg) divided by Discharged Volume (L) YTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Rask oppretting av mål for tidsintelligens kan bare grupperes eller filtreres etter datohierarkiet eller den primære datokolonnen levert av Power BI."),
				TOTALYTD(
					[Discharged Oil Mass ISO (mg) divided by Discharged Volume (L)],
					'Dim_Date'[Date].[Date]
				)
			)
		formatString: 0
		lineageTag: 92fbee52-6a01-4658-8d05-62973b8f0c75

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "YearToDate"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Discharged Volume (L) YTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Rask oppretting av mål for tidsintelligens kan bare grupperes eller filtreres etter datohierarkiet eller den primære datokolonnen levert av Power BI."),
				TOTALYTD(
					SUM('Oily water'[Discharged Volume (L)]),
					'Dim_Date'[Date].[Date]
				)
			)
		lineageTag: 8c809303-6a4f-4706-a7f2-f19db45b3fed

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "YearToDate"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

