	column 'Discharged Oil Mass ISO (mg)'
		dataType: double
		lineageTag: d8aa77bd-32fa-4769-8dd0-d62584de5bdb
		summarizeBy: sum
		sourceColumn: Discharged Oil Mass ISO (mg)

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Oily water-e826c72e-f97c-4d87-a07e-1f5f4d956217' = m
		mode: import
		source = ```
				let
				    Source = Sql.Database(
				        "obax4o2iqosevp5oa2r6dbtune-2dhddioar5aebauc4huzjvnrve.datawarehouse.fabric.microsoft.com",
				        "wh_gold_hsseq",
				        [Query = "
				WITH base AS (
				    SELECT
				        CAST([date] AS date) AS [Time_Id],
				        
				        CASE 
				            WHEN RIGHT([business_area], 5) = ' Area' 
				                THEN LEFT([business_area], LEN([business_area]) - 5)
				            ELSE [business_area]
				        END                                 AS [Asset],
				
				        CASE 
				            WHEN [field] = 'Idun Nord' THEN 'Idun Nord/' + COALESCE(CAST([facility] AS nvarchar(200)), '')
				            WHEN [field] = 'Alve Nord' THEN 'Alve Nord/' + COALESCE(CAST([facility] AS nvarchar(200)), '')
				            WHEN [field] = 'Ørn' THEN 'Ørn/' + COALESCE(CAST([facility] AS nvarchar(200)), '')
				            WHEN [field] = 'Fenris' THEN 'Fenris/' + COALESCE(CAST([facility] AS nvarchar(200)), '')
				            WHEN [field] = 'Hod'    THEN 'Hod/'    + COALESCE(CAST([facility] AS nvarchar(200)), '')
				            ELSE COALESCE(CAST([facility] AS nvarchar(200)), '')
				        END AS [facility],
				        CASE 
				            WHEN [field] = 'HANZ'   THEN 'Ivar Aasen'
				            WHEN [field] = 'Fenris' THEN 'Valhall'
				            WHEN [field] = 'Hod'    THEN 'Valhall'
				
				            WHEN field = 'PL 001B Ivar Aasen'    THEN 'Ivar Aasen'
				            WHEN field = 'Tambar'                THEN 'Ula'
				            WHEN field = 'Alve Nord'             THEN 'Skarv'
				            WHEN field = 'Idun Nord'             THEN 'Skarv'
				            WHEN field = 'Ørn'                   THEN 'Skarv'
				            WHEN field = 'Symra'                 THEN 'Ivar Aasen'
				            WHEN field = 'Solveig'               THEN 'Edvard Grieg'
				
				            ELSE [field]
				        END AS [Field],
				
				        [stream_type] AS [Stream Type],
				
				        -- Normalize all metric NULLs to 0.0
				        COALESCE(CAST([discharged_oil_mass_iso_mg] AS float), 0.0) AS [Discharged Oil Mass ISO (mg)],
				        COALESCE([discharged_oil_concentration_iso_mg_l], 0.0) AS [Discharged Oil Concentration ISO],
				        COALESCE(CAST([discharged_volume_m3] AS float), 0.0) * 1000 AS [Discharged Volume (L)],
				        COALESCE([production_volume_m3],                  0.0) AS [Production Volume],
				        COALESCE([injected_volume_m3],                    0.0) AS [Injected Volume]
				
				    FROM [dbt_gold_nems_environment_kpi].[fact_nems__environment_kpi_oily_water_ctt]
				    WHERE CAST([date] AS date) >= '2020-01-01'
				      AND CAST([date] AS date) <= CAST(GETDATE() AS date) AND  
				    fabric_valid_to_date = '9999-12-31 00:00:00.000000'
				)
				SELECT
				    b.*,
				
				    [Tillatelser] = CASE
				        WHEN b.[Field] IN ('Valhall', 'Skarv') AND b.[Stream Type] = 'Drainage Water' AND YEAR(b.[Time_Id]) = 2026 THEN 15
				        WHEN b.[Field] IN ('Valhall', 'Skarv') AND b.[Stream Type] = 'Drainage Water' AND YEAR(b.[Time_Id]) <> 2026 THEN 30
				        
				        WHEN b.[Field] IN ('Ula') AND b.[Stream Type] = 'Drainage Water' THEN 30
				        
				        WHEN b.[Field] IN ('Alvheim') AND b.[Stream Type] = 'Drainage Water' AND YEAR(b.[Time_Id]) = 2026 THEN 20
				        WHEN b.[Field] IN ('Alvheim') AND b.[Stream Type] = 'Drainage Water' AND YEAR(b.[Time_Id]) < 2026 THEN 30
				        
				        WHEN b.[Field] IN ('Valhall', 'Ula', 'Skarv', 'Alvheim') AND b.[Stream Type] = 'Produced Water' AND YEAR(b.[Time_Id]) <> 2026 THEN 15
				        WHEN b.[Field] IN ('Valhall', 'Ula', 'Skarv', 'Alvheim') AND b.[Stream Type] = 'Produced Water' AND YEAR(b.[Time_Id]) = 2026 THEN 30
				
				        WHEN b.[Field] IN ('PL 001B Ivar Aasen', 'Edvard Grieg') AND YEAR(b.[Time_Id]) <> 2026 THEN 30
				        WHEN b.[Field] IN ('Edvard Grieg', 'PL 001B Ivar Aasen') AND YEAR(b.[Time_Id]) = 2026 AND b.[Stream Type] = 'Drainage Water' THEN 15
				        WHEN b.[Field] IN ('Edvard Grieg', 'PL 001B Ivar Aasen') AND YEAR(b.[Time_Id]) = 2026 AND b.[Stream Type] = 'Produced Water' THEN 30
				        ELSE NULL
				    END,
				
				    [KPI Oil to sea] = CASE
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) = 2020 THEN 12
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) = 2021 THEN 16
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) = 2022 THEN 16
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) > 2022 AND YEAR(b.[Time_Id]) < 2025 THEN 15
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) = 2025 THEN 17
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) = 2026 THEN 16
				
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) = 2021 THEN 20
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) > 2021 AND YEAR(b.[Time_Id]) < 2024 THEN 25
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) > 2023 AND YEAR(b.[Time_Id]) < 2025 THEN 22.5
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) = 2025 THEN 21
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) = 2026 THEN 21
				
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) < 2021 THEN 25
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) > 2020 THEN 20
				
				        WHEN b.[Field] = 'Skarv'   AND YEAR(b.[Time_Id]) < 2022 THEN 12
				        WHEN b.[Field] = 'Skarv'   AND YEAR(b.[Time_Id]) >= 2022 AND YEAR(b.[Time_Id]) < 2024 THEN 15
				        WHEN b.[Field] = 'Skarv'   AND YEAR(b.[Time_Id]) = 2024 THEN 12
				        WHEN b.[Field] = 'Skarv'   AND YEAR(b.[Time_Id]) = 2025 THEN 15
				        WHEN b.[Field] = 'Skarv'   AND YEAR(b.[Time_Id]) = 2026 THEN 15
				
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) <= 2022 THEN 25
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) > 2022 THEN 15
				
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) > 2020 THEN 25
				        ELSE NULL
				    END,
				
				    [KPI drain water] = CASE
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) < 2025 THEN 12
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) = 2025 THEN 15
				        WHEN b.[Field] = 'Valhall' AND YEAR(b.[Time_Id]) = 2026 THEN 15
				
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) = 2020 THEN 20
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) = 2021 THEN 15
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) > 2021 AND YEAR(b.[Time_Id]) < 2025 THEN 20
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) = 2025 THEN 15
				        WHEN b.[Field] = 'Ula'     AND YEAR(b.[Time_Id]) = 2026 THEN 15 
				
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) < 2023 THEN 25
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) > 2022 AND YEAR(b.[Time_Id]) < 2026 THEN 20
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) = 2026 THEN 15
				
				
				        WHEN b.[Field] = 'Skarv' THEN 12
				
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) <= 2022 THEN 25
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) = 2023 THEN 20
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) = 2024 THEN 18
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) = 2025 THEN 13
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) = 2026 THEN 13
				
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) > 2020 AND YEAR(b.[Time_Id]) < 2023 THEN 25
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) > 2022 AND YEAR(b.[Time_Id]) < 2024 THEN 20
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) = 2024 THEN 15
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) = 2025 THEN 13
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) = 2026 THEN 10
				        ELSE NULL 
				    END,
				
				    [KPI water reinjected] = CASE
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) > 2020 AND YEAR(b.[Time_Id]) < 2024 THEN 0.9
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) = 2024 THEN 0.95
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) = 2025 THEN 0.96
				        WHEN b.[Field] = 'Alvheim' AND YEAR(b.[Time_Id]) = 2026 THEN 0.95
				
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) < 2021 THEN 0.95
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) > 2020 AND YEAR(b.[Time_Id]) < 2023 THEN 0.97
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) > 2022 AND YEAR(b.[Time_Id]) < 2026 THEN 0.95
				        WHEN b.[Field] = 'PL 001B Ivar Aasen' AND YEAR(b.[Time_Id]) = 2026 THEN 0.91
				
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) > 2020 AND YEAR(b.[Time_Id]) < 2024 THEN 0.95
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) = 2024 THEN 0.5
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) = 2025 THEN 0.95
				        WHEN b.[Field] = 'Edvard Grieg' AND YEAR(b.[Time_Id]) = 2026 THEN 0.95
				        ELSE NULL
				    END
				FROM base AS b;
				        "]
				    ),
				
				    // Your existing steps
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Time_Id", type date}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each true),
				    #"År satt inn" = Table.AddColumn(#"Filtered Rows", "År", each Date.Year([Time_Id]), Int64.Type),
				    #"Sammenslått kolonne satt inn" = Table.AddColumn(#"År satt inn", "loc_key", each Text.Combine({[Asset], [facility], Text.From([År], "nb-NO")}, "_"), type text),
				    #"Trimmet tekst" = Table.TransformColumns(#"Sammenslått kolonne satt inn",{{"loc_key", Text.Trim, type text}}),
				    #"Erstattet verdi" = Table.ReplaceValue(#"Trimmet tekst"," ","",Replacer.ReplaceText,{"loc_key"}),
				    #"Tekst med små bokstaver" = Table.TransformColumns(#"Erstattet verdi",{{"loc_key", Text.Lower, type text}}),
				    #"Erstattet verdi1" = Table.ReplaceValue(#"Tekst med små bokstaver","HANZ","Ivar Aasen",Replacer.ReplaceText,{"Asset"}),
				    #"Filtrerte rader" = Table.SelectRows(#"Erstattet verdi1", each true)
				in
				    #"Filtrerte rader"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigasjon

