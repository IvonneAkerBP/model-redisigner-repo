table CH4_NMVOC
	lineageTag: cbe3aee4-f83d-498d-ac6d-de584b7e0133

	measure 'Common And Vented CH4 (kg) YTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				TOTALYTD(SUM('CH4_NMVOC'[CH4 Emissions (tonne)]), 'Dim_Date'[Date])
			)
		lineageTag: aeb956f9-9b9f-4b18-8b4b-ad102d6aca86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Common And Vented NMVOC (tonne) YTD' =
			
			IF(
				ISFILTERED('Dim_Date'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				TOTALYTD(SUM('CH4_NMVOC'[nmVOC Emissions (tonne)]), 'Dim_Date'[Date])
			)
		lineageTag: e9aca34a-09c6-4a91-8c15-65bbd6c6ef1e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'nmVOC KPI year' = CALCULATE(MAX(CH4_NMVOC[Tillatelse nmVOC])*0.9,(CH4_NMVOC[field]  IN {"Ula"})) + CALCULATE(MAX(CH4_NMVOC[Tillatelse nmVOC]), NOT (CH4_NMVOC[field]  IN {"Ula"}))
		lineageTag: 39f87971-f22d-4549-9b0c-623ae2857dab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CH4 KPI year' = CALCULATE(MAX(CH4_NMVOC[Tillatelse CH4])*0.9,(CH4_NMVOC[field]  IN {"Ula"})) + CALCULATE(MAX(CH4_NMVOC[Tillatelse CH4]), NOT (CH4_NMVOC[field]  IN {"Ula"}))
		lineageTag: 927862a8-8b5d-4589-8715-047a5dea3124

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'nmVOC_cold_KPI year' = MAX(CH4_NMVOC[KPI nmVOC])*12/MONTH(LASTDATE(CH4_NMVOC[Date]))
		lineageTag: 65fb6664-904a-42ee-99e4-ce52eeb9f4d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CH4_year KPI' = MAX(CH4_NMVOC[KPI CH4])*12/MONTH(LASTDATE(CH4_NMVOC[Date]))
		lineageTag: a17f02f1-5e4a-4f8a-a7ea-c12d86fc7def

		annotation PBI_FormatHint = {"isGeneralNumber":true}

