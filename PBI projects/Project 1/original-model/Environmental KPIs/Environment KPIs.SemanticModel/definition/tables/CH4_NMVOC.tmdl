	column Year
		dataType: int64
		formatString: 0
		lineageTag: 13dd82e7-6585-4d4c-a0d3-7ce88bcb96a9
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	partition CH4_NMVOC-187efb84-7c1f-4cf8-9b70-a5f1ea7776ef = m
		mode: import
		source = ```
				let
				    Source = Sql.Database(
				        "obax4o2iqosevp5oa2r6dbtune-2dhddioar5aebauc4huzjvnrve.datawarehouse.fabric.microsoft.com",
				        "wh_gold_hsseq",
				        [Query = "
				
				WITH cte_hydro AS (
				    SELECT 
				        CAST([date] AS date)                             AS [Date],
				        [field],
				        [facility],
				        [common_and_vented_ch4_kg]/1000                       AS [CH4 Emissions (tonne)],
				        [common_and_vented_nmvoc_kg]/1000                     AS [nmVOC Emissions (tonne)],
				        CONCAT(REPLACE([field], 'PL 001B Ivar Aasen', 'Ivar Aasen'), '_', [facility], '_', YEAR([date])) AS [loc_key],
				        CASE
				            WHEN [field] = 'PL 001B Ivar Aasen' THEN 56
				            WHEN [field] = 'Skarv' THEN 80
				            WHEN ([field] = 'Alvheim' AND YEAR([date]) < 2026) THEN 315
				            WHEN ([field] = 'Alvheim' AND YEAR([date]) >= 2026) THEN 200
				            WHEN ([field] = 'Valhall' AND YEAR([date]) < 2025) THEN 20
				            WHEN ([field] = 'Valhall' AND YEAR([date]) > 2024) THEN 49
				            WHEN [field] = 'Edvard Grieg' THEN 132
				            WHEN ([field] = 'Ula' AND YEAR([date]) > 2022 AND YEAR([date]) < 2025) THEN 195
				            WHEN ([field] = 'Ula' AND YEAR([date]) > 2024) THEN 260
				            ELSE NULL
				        END                                              AS [Tillatelse CH4],  -- CH4 tillatelse
				        CASE 
				            WHEN [field] = 'PL 001B Ivar Aasen' AND [facility] = 'Ivar Aasen' THEN 41
				            WHEN [field] = 'PL 001B Ivar Aasen' AND [facility] <> 'Ivar Aasen' AND YEAR([date]) < 2023 THEN 9
				            WHEN [field] = 'PL 001B Ivar Aasen' AND [facility] <> 'Ivar Aasen' AND YEAR([date]) > 2022 THEN 21
				            WHEN [field] = 'PL 001B Ivar Aasen' AND [facility] <> 'Ivar Aasen' AND YEAR([date]) = 2026 THEN 74.9
				            
				            WHEN [field] = 'Skarv' AND [facility] <> 'Skarv FPSO' AND YEAR([date]) <> 2026 THEN 45
				            WHEN [field] = 'Skarv' AND [facility] <> 'Skarv FPSO' AND YEAR([date]) = 2026 THEN 68.8
				            WHEN [field] = 'Skarv' AND [facility] = 'Skarv FPSO' AND YEAR([date]) <> 2026 THEN 45  
				            WHEN [field] = 'Skarv' AND [facility] = 'Skarv FPSO' AND YEAR([date]) = 2026 THEN 40 
				
				            WHEN [field] = 'Alvheim' THEN 162
				            WHEN [field] = 'Alvheim' AND [facility] <> 'Alvheim' AND YEAR([date]) = 2026 THEN 62
				
				            WHEN ([field] = 'Valhall' AND YEAR([date]) < 2025) THEN 24
				            WHEN ([field] = 'Valhall' AND YEAR([date]) > 2024) THEN 27
				            WHEN [field] = 'Valhall' AND [facility] <> 'Valhall' AND YEAR([date]) = 2026 THEN 90
				            
				            WHEN [field] = 'Edvard Grieg' AND [facility] = 'Edvard Grieg' AND YEAR([date]) <> 2026 THEN 127
				            WHEN [field] = 'Edvard Grieg' AND [facility] = 'Edvard Grieg' AND YEAR([date]) = 2026 THEN 127
				            WHEN [field] = 'Edvard Grieg' AND [facility] <> 'Edvard Grieg' AND YEAR([date]) <> 2026 THEN 19
				            WHEN [field] = 'Edvard Grieg' AND [facility] <> 'Edvard Grieg' AND YEAR([date]) = 2026 THEN 38.7
				
				            WHEN ([field] = 'Ula' AND [facility] = 'ULA PP' AND YEAR([date]) > 2022 AND YEAR([date]) < 2025) THEN 60
				            WHEN ([field] = 'Ula' AND [facility] = 'ULA PP' AND YEAR([date]) > 2024) THEN 139
				            
				            WHEN ([field] = 'Ula' AND [facility] <> 'ULA PP' AND YEAR([date]) = 2026) THEN 48
				            WHEN ([field] = 'Ula' AND [facility] <> 'ULA PP' AND YEAR([date]) > 2022 AND YEAR([date]) < 2026) THEN 47
				
				            ELSE NULL
				        END                                              AS [Tillatelse nmVOC],  -- nmVOC tillatelse
				        MONTH([date])                                    AS [Month],  -- for KPI calc
				        YEAR([date])                                     AS [Year]    -- for KPI calc
				    FROM [dbt_gold_nems_environment_kpi].[fact_nems__hydrocarbon_gas_emissions_ctt]
				    WHERE 
				    fabric_valid_to_date = '9999-12-31 00:00:00.000000'
				),
				cte_combustion AS (
				    SELECT 
				        CAST([date] AS date)                             AS [Date]
				       ,[field]
				       ,[facility]
				       ,[ch4_emissions_tonnes]/1000                           AS [CH4 Emissions (tonne)]
				       ,[nm_voc_emissions_tonnes]/1000                        AS [nmVOC Emissions (tonne)]
				       ,CONCAT(REPLACE([field], 'PL 001B Ivar Aasen', 'Ivar Aasen'), '_', [facility]) AS [loc_key]
				       ,CAST(56 AS int)                                  AS [Tillatelse CH4]   -- CH4 tillatelse
				       ,CAST(41 AS int)                                  AS [Tillatelse nmVOC] -- NMVOC tillatelse
				       ,MONTH([date])                                    AS [Month]            -- for KPI calc
				       ,YEAR([date])                                     AS [Year]             -- for KPI calc
				    FROM [dbt_gold_nems_environment_kpi].[fact_nems__environment_kpi_combustion_ctt]
				    WHERE CAST([date] AS date) > '2020-12-31' AND  
				    fabric_valid_to_date = '9999-12-31 00:00:00.000000'
				)
				
				-- Branch 1 (hydro): KPI rules by field/year
				SELECT 
				    t.*
				  ,CASE 
				        WHEN t.[field] = 'PL 001B Ivar Aasen' AND t.[Year] < 2026     THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'PL 001B Ivar Aasen' AND t.[Year] = 2026     THEN 45.0 / 12.0 * t.[Month]
				 
				        WHEN t.[field] = 'Skarv'         AND t.[Year] <= 2025         THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Skarv'         AND t.[Year] > 2025          THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month] * 0.9 
				        
				        WHEN t.[field] = 'Alvheim'                                    THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month]
				        
				        WHEN t.[field] = 'Valhall'       AND t.[Year] < 2025          THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Valhall'       AND t.[Year] > 2024          THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month] * 0.9
				        
				        WHEN t.[field] = 'Edvard Grieg'  AND t.[Year] < 2023          THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Edvard Grieg'  AND t.[Year] > 2022  AND t.[Year] < 2026         THEN (100.0 / 12) * t.[Month]
				        WHEN t.[field] = 'Edvard Grieg'  AND t.[Year] = 2026          THEN (80.0 / 12) * t.[Month]
				        
				        WHEN t.[field] = 'Ula'           AND t.[Year] = 2023          THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Ula'           AND t.[Year] > 2023          THEN CAST(t.[Tillatelse CH4] AS float) / 12 * t.[Month] * 0.9
				        ELSE NULL
				    END AS [KPI CH4]
				  ,CASE
				        WHEN t.[field] = 'PL 001B Ivar Aasen' AND t.[Year] <> 2026    THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'PL 001B Ivar Aasen' AND t.[facility] = 'Ivar Aasen' AND t.[Year] = 2026  THEN (35.0 / 12.0) * t.[Month]
				        WHEN t.[field] = 'PL 001B Ivar Aasen' AND t.[facility] <> 'Ivar Aasen' AND t.[Year] = 2026  THEN (44.01 / 12.0) * t.[Month]                         
				        
				
				        WHEN t.[field] = 'Skarv'    AND t.[Year] <> 2026              THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Skarv' AND t.[facility] = 'Skarv FPSO' AND t.[Year] = 2026 THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month] * 0.9
				        WHEN t.[field] = 'Skarv' AND t.[facility] <> 'Skarv FPSO' AND t.[Year] = 2026  THEN 62    
				
				        
				        WHEN t.[field] = 'Alvheim'   AND t.[Year] < 2026              THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Alvheim' AND t.[facility] = 'Alvheim' AND t.[Year] = 2026   THEN 100
				        WHEN t.[field] = 'Alvheim' AND t.[facility] <> 'Alvheim' AND t.[Year] = 2026  THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month] * 0.9 
				        
				        WHEN t.[field] = 'Valhall'       AND t.[Year] < 2025          THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Valhall'       AND t.[Year] > 2024          THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month] * 0.9
				        
				        WHEN t.[field] = 'Edvard Grieg'  AND t.[Year] < 2023          THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Edvard Grieg'  AND t.[Year] > 2022  AND t.[Year] < 2026          THEN (100.0 / 12) * t.[Month]
				        WHEN t.[field] = 'Edvard Grieg' AND t.[facility] = 'Edvard Grieg' AND t.[Year] = 2026  THEN (85.0 / 12.0) * t.[Month]
				        WHEN t.[field] = 'Edvard Grieg' AND t.[facility] <> 'Edvard Grieg' AND t.[Year] = 2026  THEN (23.0 / 12.0) * t.[Month]    
				
				        
				        WHEN t.[field] = 'Ula'           AND t.[Year] = 2023          THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month]
				        WHEN t.[field] = 'Ula'           AND t.[Year] > 2023          THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month] * 0.9
				        WHEN t.[field] = 'Ula' AND t.[facility] = 'Ula PP' AND t.[Year] = 2026 THEN CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month] * 0.9
				        WHEN t.[field] = 'Ula' AND t.[facility] <> 'Ula PP' AND t.[Year] = 2026  THEN 0    
				
				
				
				        ELSE NULL
				    END AS [KPI nmVOC]
				FROM cte_hydro AS t
				
				UNION ALL
				
				-- Branch 2 (combustion): simple monthly pro‑rate KPIs
				SELECT 
				    t.*
				  ,CAST(CAST(t.[Tillatelse CH4]   AS float) / 12 * t.[Month] AS decimal(10,2)) AS [KPI CH4]
				  ,CAST(CAST(t.[Tillatelse nmVOC] AS float) / 12 * t.[Month] AS decimal(10,2)) AS [KPI nmVOC]
				FROM cte_combustion AS t
				"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Date", type date}}),
				    #"Erstattet verdi" = Table.ReplaceValue(#"Changed Type"," ","",Replacer.ReplaceText,{"loc_key"}),
				    #"Tekst med små bokstaver" = Table.TransformColumns(#"Erstattet verdi",{{"loc_key", Text.Lower, type text}})
				in
				    #"Tekst med små bokstaver"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigasjon

